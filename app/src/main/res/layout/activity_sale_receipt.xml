<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".SaleReceiptActivity">

    <ScrollView
        android:id="@+id/receiptScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/receiptCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/layoutReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvReceiptShopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="MoiBit Repair Phone"
                    android:textColor="@color/brandBlue"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvReceiptShopDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Dirección del Taller"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:textAlignment="center" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvReceiptSaleId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VENTA #001"
                    android:textColor="@color/brandBlue"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvReceiptDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fecha: 25/05/2024"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETALLE DEL CLIENTE"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvReceiptCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nombre: Juan Pérez"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono: 78945612"
                    android:textColor="@color/brandBlue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETALLE DEL EQUIPO"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvReceiptModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Modelo: Samsung A14"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptImei"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMEI: 123456789012345"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Condición: Nuevo"
                    android:textColor="@color/brandBlue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL PAGADO"
                        android:textColor="@color/brandBlue"
                        android:fontFamily="sans-serif-bold" />
                    <TextView
                        android:id="@+id/tvReceiptTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/brandBlue"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTermsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="GARANTÍA"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvReceiptWarranty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Este equipo cuenta con garantía."
                    android:textSize="12sp"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Notas..."
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="sans-serif-italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:text="¡Gracias por su compra!"
                    android:textColor="@color/brandBlue"
                    android:textStyle="italic" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintBluetooth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:text="IMPRIMIR NOTA (BT)"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            app:backgroundTint="@color/brandPrimary"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/stat_sys_data_bluetooth" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsapp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:textColor="@color/brandPrimary"
                android:fontFamily="sans-serif-black"
                app:cornerRadius="24dp"
                app:strokeColor="@color/brandPrimary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveImage"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Imagen"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                app:backgroundTint="@color/brandPrimary"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="FINALIZAR"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            app:backgroundTint="@color/brandPrimary"
            app:cornerRadius="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
