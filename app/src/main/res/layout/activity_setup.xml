<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Ajustes"
            app:titleCentered="true"
            app:titleTextColor="@color/brandBlue" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/llStepIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="visible">
        <View android:id="@+id/vStep1" android:layout_width="40dp" android:layout_height="6dp" android:background="@color/brandBlue" android:layout_margin="4dp" />
        <View android:id="@+id/vStep2" android:layout_width="40dp" android:layout_height="6dp" android:background="@color/divider" android:layout_margin="4dp"/>
        <View android:id="@+id/vStep3" android:layout_width="40dp" android:layout_height="6dp" android:background="@color/divider" android:layout_margin="4dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Logo Área Mejorada -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="2dp">
                        <ImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:foreground="?attr/selectableItemBackground"
                            android:contentDescription="Logo del Taller"
                            android:src="@mipmap/ic_launcher" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:text="Configuración"
                        android:textColor="@color/brandBlue"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvStepDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:text="Paso 1 de 3"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp" />

                    <!-- STEP 1: GENERAL -->
                    <LinearLayout
                        android:id="@+id/llStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="INFORMACIÓN GENERAL"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.15" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Nombre del Taller"
                            app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                            app:startIconTint="@color/brandBlue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etShopName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Nombre del Dueño"
                            app:startIconDrawable="@android:drawable/ic_menu_edit"
                            app:startIconTint="@color/brandBlue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOwnerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Ubicación"
                            app:startIconDrawable="@android:drawable/ic_dialog_map"
                            app:startIconTint="@color/brandBlue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etShopLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cvCountry"
                                android:layout_width="100dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/border"
                                app:strokeWidth="1dp">
                                <Spinner
                                    android:id="@+id/spCountry"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/surface" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilShopPhone"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="Celular"
                                app:startIconDrawable="@android:drawable/ic_menu_call"
                                app:startIconTint="@color/brandBlue">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etShopPhone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="phone"
                                    android:textColor="@color/textPrimary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNext1"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="32dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Siguiente"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp"
                            app:backgroundTint="@color/brandBlue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSkipSetup"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Configurar más tarde"
                            android:textColor="@color/textSecondary"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <!-- STEP 2: SOCIAL -->
                    <LinearLayout
                        android:id="@+id/llStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="REDES SOCIALES"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.15" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/swEnableSocialMedia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Habilitar Redes Sociales"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:id="@+id/llSocialMediaFields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Facebook">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etShopFacebook"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/textPrimary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Instagram">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etShopInstagram"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/textPrimary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="TikTok">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etShopTiktok"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/textPrimary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:hint="PIN Seguridad"
                            app:startIconDrawable="@android:drawable/ic_lock_lock"
                            app:startIconTint="@color/brandBlue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSettingsPin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberPassword"
                                android:maxLength="6"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNext2"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="32dp"
                            android:text="Siguiente"
                            android:textAllCaps="false"
                            android:fontFamily="sans-serif-black"
                            app:cornerRadius="16dp"
                            app:backgroundTint="@color/brandBlue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tvBack1"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Atrás"
                            android:textColor="@color/textSecondary" />
                    </LinearLayout>

                    <!-- STEP 3: POLICIES -->
                    <LinearLayout
                        android:id="@+id/llStep3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="TEMA Y VISUALIZACIÓN"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.15" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Modo de Tema"
                                    android:textColor="@color/textPrimary"
                                    android:fontFamily="sans-serif-medium"
                                    android:textSize="14sp" />
                                <Spinner
                                    android:id="@+id/spThemeMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="POLÍTICAS Y AJUSTES"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.15" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Garantía"
                            app:suffixText="días">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWarrantyDays"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Términos y Condiciones">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etShopTerms"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:gravity="top"
                                android:minLines="3"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/swRequireSignature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Requerir Firma del Cliente"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/swShowAmounts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Mostrar Recaudado/Por Cobrar"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveSetup"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="32dp"
                            android:text="Finalizar"
                            android:textAllCaps="false"
                            android:fontFamily="sans-serif-black"
                            app:cornerRadius="16dp"
                            app:backgroundTint="@color/brandGreen" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tvBack2"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Atrás"
                            android:textColor="@color/textSecondary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup Section Mejorada -->
            <LinearLayout
                android:id="@+id/llBackupSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/surface"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MANTENIMIENTO"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/textSecondary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBackup"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Exportar"
                                android:textColor="@color/brandBlue"
                                app:strokeColor="@color/brandBlue"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRestore"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Importar"
                                android:textColor="@color/brandBlue"
                                app:strokeColor="@color/brandBlue"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Firma By MoiBit en Pasos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="By MoiBit"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:alpha="0.7" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
