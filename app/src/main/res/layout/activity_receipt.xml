<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/receiptScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/receiptCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:id="@+id/layoutReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_section_tint"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Recibo técnico"
                    android:textAllCaps="true"
                    android:textColor="@color/brandBlue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReceiptShopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="MoiBit Repair Phone"
                    android:textColor="@color/brandBlue"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvReceiptShopDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Dirección del Taller"
                    android:textAlignment="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvReceiptOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="ORDEN #001"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fecha: 25/05/2024"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="DETALLE DEL CLIENTE"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nombre: Juan Pérez"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono: 78945612"
                    android:textColor="@color/brandBlue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="DETALLE DEL EQUIPO"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Modelo: iPhone 13 Pro"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptImei"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMEI: 123456789012345"
                    android:textColor="@color/brandBlue" />

                <TextView
                    android:id="@+id/tvReceiptIssue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Falla: Cambio de pantalla"
                    android:textColor="@color/brandBlue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="TOTAL"
                        android:textColor="@color/brandBlue" />

                    <TextView
                        android:id="@+id/tvReceiptTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="0.00"
                        android:textColor="@color/brandBlue"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ANTICIPO"
                        android:textColor="@color/textSecondary" />

                    <TextView
                        android:id="@+id/tvReceiptDownPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="0.00"
                        android:textColor="@color/brandGreen" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReceiptBalanceLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="SALDO PENDIENTE"
                        android:textColor="@color/brandBlue" />

                    <TextView
                        android:id="@+id/tvReceiptBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="0.00"
                        android:textColor="#EF4444"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:id="@+id/vSeparatorTerms"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvTermsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="TÉRMINOS Y CONDICIONES"
                    android:textColor="@color/textSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvReceiptTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Términos aquí..."
                    android:textColor="@color/textSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:text="¡Gracias por su confianza!"
                    android:textColor="@color/brandBlue"
                    android:textStyle="italic" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_bar_surface"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeliverFromReceipt"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-black"
            android:text="COBRAR Y ENTREGAR"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="#EF4444"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_menu_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintBluetooth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-black"
            android:text="IMPRIMIR TICKET (BT)"
            android:textColor="@color/white"
            app:backgroundTint="@color/brandPrimary"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/stat_sys_data_bluetooth" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsapp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="WhatsApp"
                android:textColor="@color/brandPrimary"
                app:cornerRadius="24dp"
                app:strokeColor="@color/brandPrimary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveImage"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Imagen"
                android:textColor="@color/white"
                app:backgroundTint="@color/brandPrimary"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
